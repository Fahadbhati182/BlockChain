# Backend Server Port
PORT=5000

# PostgreSQL / Supabase Database Connection URL
# Example Supabase: postgresql://postgres:[YOUR-PASSWORD]@db.[YOUR-PROJECT-REF].supabase.co:5432/postgres
# Example Local: postgresql://postgres:postgres@localhost:5432/library_db
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/library_db

# Environment
NODE_ENV=development
